<Window x:Class="DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island" Width="640" Height="290"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Ink}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="#FF3A3A3C" />
        </Style>

        <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="99">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StepTemplate" DataType="{x:Type local:AgentStep}">
            <Grid Height="18">
                <Grid x:Name="Done" Width="13" Height="13" HorizontalAlignment="Left">
                    <Ellipse Fill="#FF30D158" />
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE73E;" FontSize="7.5" FontWeight="Bold" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <Path x:Name="Spin" Width="13" Height="13" HorizontalAlignment="Left" Visibility="Collapsed" Stroke="{DynamicResource Ink}" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6.5,1.2 A5.3,5.3 0 1 1 1.2,6.5" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform />
                    </Path.RenderTransform>
                    <Path.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard Timeline.DesiredFrameRate="30">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Path.Triggers>
                </Path>
                <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" Margin="21,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Done" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Spin" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Ink}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type local:DiffLine}">
            <Border x:Name="Bg" Background="#2EFF453A" Padding="6,1.5" Margin="0,0,0,1" CornerRadius="3">
                <DockPanel>
                    <TextBlock x:Name="Sign" Text="{Binding Sign}" Width="13" Foreground="#FFFF6B6B" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />
                    <TextBlock x:Name="Line" Text="{Binding Text}" Foreground="#FFFFA8A8" TextDecorations="Strikethrough" FontFamily="Cascadia Mono, Consolas"
                               FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Added}" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#2630D158" />
                    <Setter TargetName="Sign" Property="Foreground" Value="#FF30D158" />
                    <Setter TargetName="Line" Property="Foreground" Value="#FFC4F5D0" />
                    <Setter TargetName="Line" Property="TextDecorations" Value="{x:Null}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FileTemplate" DataType="{x:Type local:FileItem}">
            <Grid x:Name="Tile" Width="76" Margin="0,0,4,0" Background="Transparent" Cursor="Hand" ToolTip="{Binding Path}"
                  MouseLeftButtonDown="FileTile_MouseDown" MouseMove="FileTile_MouseMove" MouseLeftButtonUp="FileTile_MouseUp">
                <Border x:Name="Hover" CornerRadius="14" Background="{DynamicResource Card}" Opacity="0" />
                <StackPanel Margin="4,10,4,6">
                    <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="0,6,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" Foreground="{DynamicResource Ink}" />
                </StackPanel>
                <Button x:Name="Remove" Style="{StaticResource TinyButton}" Content="&#xE711;" Visibility="Hidden"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Click="FileRemove_Click" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Opacity" Value="1" />
                    <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="AgentTemplate" DataType="{x:Type local:AgentSession}">
            <Grid Height="34" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Viewbox Width="21" Height="21" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <local:PetView Active="False" TintColor="{Binding StateColor}" />
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding OrbBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Elapsed}" FontSize="10.5" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <StackPanel x:Name="IslandHost" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
            <!-- Mirrors the privacy dots' width so the island stays centred -->
            <Border x:Name="PrivacySpacer" Width="0" />

            <Path x:Name="EarLeft" Width="14" Height="14" VerticalAlignment="Top" Fill="Black" Visibility="Collapsed"
                  Data="M0,0 H14 V14 A14,14 0 0 0 0,0 Z" />

            <Grid x:Name="Island" Width="132" Height="34" Background="Transparent" AllowDrop="True" Cursor="Arrow"
                  MouseLeftButtonUp="Island_MouseLeftButtonUp" MouseRightButtonUp="Island_MouseRightButtonUp"
                  PreviewMouseWheel="Island_PreviewMouseWheel"
                  DragEnter="Island_DragOver" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop">

                <Border x:Name="GlassFill" Visibility="Collapsed" />
                <Border x:Name="IslandBg" Background="Black" CornerRadius="17">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black" RenderingBias="Performance" />
                    </Border.Effect>
                </Border>

                <!-- Liquid glass rim: a bright edge catching light from the top-left, a softer one bottom-right -->
                <Border x:Name="GlassRim" Visibility="Collapsed" BorderThickness="1.2" IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D9FFFFFF" Offset="0" />
                            <GradientStop Color="#2EFFFFFF" Offset="0.35" />
                            <GradientStop Color="#14FFFFFF" Offset="0.65" />
                            <GradientStop Color="#8CFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#24FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.5" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid x:Name="IslandContent">

                    <!-- Activity hint inside the slim idle handle -->
                    <Border x:Name="HandleBar" Width="26" Height="3" CornerRadius="1.5" Opacity="0" IsHitTestVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2.5,0,0" />

                    <!-- ===== Compact ===== -->
                    <Grid x:Name="CompactView" Height="34" VerticalAlignment="Top">
                        <local:PetView x:Name="CompactPet" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,1" Panel.ZIndex="1" />
                        <TextBlock x:Name="CompactClock" Text="00:00" FontSize="13.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Grid x:Name="CompactMedia" Visibility="Collapsed">
                            <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="7" Background="#FF2C2C2E"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0" />
                            <StackPanel x:Name="CompactEq" Orientation="Horizontal" Height="14"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock x:Name="CompactLyric" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                                       VerticalAlignment="Center" Margin="40,0,44,0" />
                        </Grid>

                        <Grid x:Name="CompactAgent" Visibility="Collapsed">
                            <Ellipse x:Name="CompactOrb" Width="12" Height="12" Fill="#FF0A84FF" RenderTransformOrigin="0.5,0.5"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock x:Name="CompactAgentText" FontSize="12" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="32,0,16,0" />
                            <Border x:Name="CompactAgentCount" Height="18" MinWidth="18" CornerRadius="9" Background="#FF2C2C2E" Padding="5,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Visibility="Collapsed">
                                <TextBlock x:Name="CompactAgentCountText" FontSize="10.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <Grid x:Name="CompactTimer" Visibility="Collapsed">
                            <Grid x:Name="CompactTimerRing" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse Stroke="#45FF9F0A" StrokeThickness="2.5" />
                                <Path x:Name="CompactTimerArc" Stroke="#FFFF9F0A" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <TextBlock x:Name="CompactTimerText" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFF9F0A"
                                       Typography.NumeralAlignment="Tabular"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                        </Grid>
                    </Grid>

                    <!-- ===== Transient activities ===== -->
                    <Grid x:Name="TransientView" Opacity="0" IsHitTestVisible="False">
                        <Grid x:Name="VolumePanel" Height="40" VerticalAlignment="Top" Margin="16,0,16,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VolumeIcon" FontFamily="{StaticResource Icons}" FontSize="15" Text="&#xE995;" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{DynamicResource Track}" Margin="12,0" ClipToBounds="True">
                                <Border x:Name="VolumeFill" Background="{DynamicResource Ink}" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="VolumeScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="12" FontWeight="SemiBold" MinWidth="26"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="BatteryPanel" Height="40" VerticalAlignment="Top" Margin="16,0,18,0" Visibility="Collapsed">
                            <TextBlock x:Name="BatteryIcon" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock x:Name="BatteryText" FontSize="12.5" FontWeight="SemiBold" Margin="28,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="BatteryPct" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="PrivacyPanel" Height="40" VerticalAlignment="Top" Margin="16,0,18,0" Visibility="Collapsed">
                            <TextBlock x:Name="PrivacyIcon" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock x:Name="PrivacyText" FontSize="12.5" FontWeight="SemiBold" Margin="28,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PrivacyApp" FontSize="12.5" Foreground="{DynamicResource Muted}" MaxWidth="110"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="InfoPanel" Height="40" VerticalAlignment="Top" Margin="16,0,18,0" Visibility="Collapsed">
                            <TextBlock x:Name="InfoIcon" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" />
                            <Border x:Name="InfoThumb" Width="26" Height="26" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="InfoText" FontSize="12.5" FontWeight="SemiBold" Margin="30,0,90,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="InfoRight" FontSize="12" Foreground="{DynamicResource Muted}" MaxWidth="86" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Claude Code asking for permission: answer from the island -->
                        <Grid x:Name="ApprovalPanel" Height="112" VerticalAlignment="Top" Margin="16,0,16,0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="62" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Viewbox x:Name="ApprovalPetBox" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <local:PetView x:Name="ApprovalPet" />
                            </Viewbox>
                            <StackPanel Margin="52,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13.5" TextTrimming="CharacterEllipsis">
                                    <Run x:Name="ApprovalAgent" FontWeight="SemiBold" />
                                    <Run Text=" esperando seu OK" Foreground="#FFFF9F0A" FontWeight="SemiBold" />
                                    <Run x:Name="ApprovalElapsed" Foreground="{DynamicResource Muted}" FontSize="12" />
                                </TextBlock>
                                <TextBlock x:Name="ApprovalDetail" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Chip}" Margin="0" Background="#FF5A1D1D" Click="ApprovalDeny_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Negar" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource Chip}" Margin="0" Background="#FF30D158" Foreground="Black" Click="ApprovalAllow_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE73E;" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Permitir" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid x:Name="NotifyPanel" Height="78" VerticalAlignment="Top" Margin="16,0,20,0" Visibility="Collapsed">
                            <Border x:Name="NotifyLogo" Width="38" Height="38" CornerRadius="10" Background="#FF2C2C2E"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="NotifyGlyph" FontFamily="{StaticResource Icons}" Text="&#xEA8F;" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="52,0,0,0" VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock x:Name="NotifyTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                                    <TextBlock x:Name="NotifyApp" FontSize="11" Foreground="{DynamicResource Muted}" MaxWidth="70"
                                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="NotifyBody" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="NowPlayingPanel" Height="62" VerticalAlignment="Top" Margin="10,0,16,0" Visibility="Collapsed">
                            <Border x:Name="NowArt" Width="42" Height="42" CornerRadius="11" Background="#FF2C2C2E"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Margin="54,0,44,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NowTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="NowArtist" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="NowEq" Orientation="Horizontal" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid x:Name="AlertPanel" Height="78" VerticalAlignment="Top" Margin="16,0,20,0" Visibility="Collapsed">
                            <Viewbox x:Name="AlertPetBox" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                                <local:PetView x:Name="AlertPet" />
                            </Viewbox>
                            <Grid Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse x:Name="AlertOrb" Fill="#FFFF9F0A" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="AlertGlyph" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xEA8F;" />
                            </Grid>
                            <StackPanel Margin="52,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AlertTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="AlertDetail" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== Expanded dashboard ===== -->
                    <Grid x:Name="ExpandedView" Width="450" Height="190" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>

                        <Border x:Name="AccentWash" Opacity="0" IsHitTestVisible="False" />

                        <Grid Margin="22,12,22,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                            </Grid.RowDefinitions>

                            <Viewbox x:Name="HeaderPetBox" Width="21" Height="21" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,-1,0,0">
                                <local:PetView x:Name="HeaderPet" />
                            </Viewbox>
                            <TextBlock x:Name="PageTitle" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HeaderInfo" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <Grid Grid.Row="1" Margin="0,6,0,4" ClipToBounds="True">
                                <!-- Media -->
                                <Grid x:Name="MediaPage">
                                    <Grid.RenderTransform>
                                        <TranslateTransform />
                                    </Grid.RenderTransform>
                                    <Grid x:Name="MediaContent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="MediaArt" Width="104" Height="104" CornerRadius="18" Background="#FF1C1C1E" VerticalAlignment="Center">
                                            <TextBlock x:Name="MediaArtGlyph" FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="32"
                                                       Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- one chip per app playing; click to control that one -->
                                        <StackPanel x:Name="MediaSources" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6,0,0,-4" />
                                        <Grid Grid.Column="1" Margin="18,6,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="MediaTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Row="1" Margin="0,1,0,0">
                                                <TextBlock x:Name="MediaArtist" FontSize="12.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="MediaSource" FontSize="11.5" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Grid Grid.Row="2" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="MediaPos" FontSize="10.5" Foreground="{DynamicResource Muted}" MinWidth="30" VerticalAlignment="Center" />
                                                <Grid x:Name="MediaTrack" Grid.Column="1" Height="12" Margin="6,0">
                                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Track}" ClipToBounds="True">
                                                        <Border x:Name="MediaProgress" Background="{DynamicResource Ink}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform x:Name="MediaProgressScale" ScaleX="0" />
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                    <Ellipse x:Name="MediaKnob" Width="11" Height="11" Fill="{DynamicResource Ink}" HorizontalAlignment="Left">
                                                        <Ellipse.RenderTransform>
                                                            <TranslateTransform x:Name="MediaKnobShift" X="-5.5" />
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock x:Name="MediaDur" Grid.Column="2" FontSize="10.5" Foreground="{DynamicResource Muted}" MinWidth="30" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource RoundButton}" Content="&#xE892;" Click="Prev_Click" />
                                                <Button x:Name="PlayButton" Style="{StaticResource RoundButton}" Content="&#xE768;" FontSize="18"
                                                        Width="42" Height="42" Margin="14,0" Click="Play_Click" />
                                                <Button Style="{StaticResource RoundButton}" Content="&#xE893;" Click="Next_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <StackPanel x:Name="MediaEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D6;" FontSize="26" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Nada tocando agora" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                        <TextBlock Text="Spotify, YouTube e outros players aparecem aqui" FontSize="11.5"
                                                   Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- System -->
                                <Grid x:Name="SystemPage" Visibility="Collapsed">
                                    <Grid.RenderTransform>
                                        <TranslateTransform />
                                    </Grid.RenderTransform>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <UniformGrid x:Name="SystemMeters" Rows="2" Columns="2" />
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="BrightnessRow" Height="22" Margin="0,0,18,0">
                                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE706;" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                            <Grid x:Name="BrightTrack" Margin="24,0,40,0" Height="22" Background="Transparent" Cursor="Hand"
                                                  MouseLeftButtonDown="Bright_MouseDown" MouseMove="Bright_MouseMove" MouseLeftButtonUp="Bright_MouseUp">
                                                <Border Height="6" CornerRadius="3" Background="{DynamicResource Track}" ClipToBounds="True" VerticalAlignment="Center">
                                                    <Border Background="#FFFFD60A" CornerRadius="3" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform x:Name="BrightScale" ScaleX="0.5" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="BrightText" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel x:Name="BluetoothList" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>

                                <!-- Files -->
                                <Grid x:Name="FilesPage" Visibility="Collapsed">
                                    <Grid.RenderTransform>
                                        <TranslateTransform />
                                    </Grid.RenderTransform>
                                    <ScrollViewer x:Name="FilesScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="FilesList" ItemTemplate="{StaticResource FileTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel x:Name="FilesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8B7;" FontSize="26" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Arraste arquivos até a ilha" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                        <TextBlock Text="Eles ficam guardados aqui para você arrastar de volta depois" FontSize="11.5"
                                                   Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Grid x:Name="DropHint" Visibility="Collapsed" Background="#CC000000">
                                        <Rectangle RadiusX="16" RadiusY="16" Stroke="{DynamicResource Faint}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE896;" FontSize="24" HorizontalAlignment="Center" />
                                            <TextBlock Text="Solte para guardar" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Agents -->
                                <Grid x:Name="AgentsPage" Visibility="Collapsed">
                                    <Grid.RenderTransform>
                                        <TranslateTransform />
                                    </Grid.RenderTransform>
                                    <Grid x:Name="AgentDetail">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="138" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid HorizontalAlignment="Left">
                                                <Viewbox Width="46" Height="46">
                                                    <local:PetView x:Name="AgentPet" />
                                                </Viewbox>
                                                <Border x:Name="AgentBadge" Width="15" Height="15" CornerRadius="7.5" Background="#FF0A84FF" BorderBrush="Black"
                                                        BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-1,0,0">
                                                    <TextBlock Text="•••" FontSize="6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="AgentProject" FontSize="14.5" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="AgentName" FontSize="11.5" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                            <ItemsControl x:Name="AgentSteps" Margin="0,6,0,0" ItemTemplate="{StaticResource StepTemplate}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="12" Background="#C80B0B0D" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="10,8">
                                            <Grid>
                                                <Grid x:Name="DiffCard" Visibility="Collapsed">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border HorizontalAlignment="Left" Background="{DynamicResource Card}" CornerRadius="6" Padding="7,3,9,3" Margin="0,0,0,7">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE943;" FontSize="11" Foreground="#FF5AC8FA" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="DiffFile" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                            <Ellipse Width="6" Height="6" Fill="#FFFF9F0A" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ItemsControl x:Name="DiffList" Grid.Row="1" ItemTemplate="{StaticResource DiffLineTemplate}" ClipToBounds="True" />
                                                </Grid>
                                                <ItemsControl x:Name="AgentsList" ItemTemplate="{StaticResource AgentTemplate}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="AgentsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE99A;" FontSize="26" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Nenhum agente ativo" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                        <TextBlock Text="Bandeja → Conectar Copilot (VS Code)" FontSize="11.5"
                                                   Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Calendar + weather -->
                                <Grid x:Name="CalendarPage" Visibility="Collapsed">
                                    <Grid.RenderTransform>
                                        <TranslateTransform />
                                    </Grid.RenderTransform>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="CalMonth" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,4" />
                                        <UniformGrid x:Name="CalGrid" Columns="7" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Margin="16,0,0,0" CornerRadius="14" Background="{DynamicResource Card}" Padding="14,10">
                                        <Grid>
                                            <StackPanel x:Name="WeatherBox">
                                                <TextBlock x:Name="WeatherPlace" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Name="WeatherIcon" FontFamily="{StaticResource Icons}" FontSize="26" VerticalAlignment="Center" Foreground="#FFFFD60A" />
                                                    <TextBlock x:Name="WeatherTemp" FontSize="34" FontWeight="SemiBold" Margin="10,0,0,0" />
                                                </StackPanel>
                                                <TextBlock x:Name="WeatherDesc" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="WeatherMore" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="WeatherEmpty" Text="Carregando o clima…" FontSize="12" Foreground="{DynamicResource Muted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Timer -->
                                <Grid x:Name="TimerPage" Visibility="Collapsed">
                                    <Grid.RenderTransform>
                                        <TranslateTransform />
                                    </Grid.RenderTransform>
                                    <StackPanel x:Name="TimerIdle" VerticalAlignment="Center">
                                        <TextBlock Text="Quanto tempo?" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="A contagem fica na ilha e ela avisa quando acabar" FontSize="11.5"
                                                   Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,14" />
                                        <StackPanel x:Name="TimerPresets" Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Grid x:Name="TimerRunning" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TimerBig" FontSize="46" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,-6,0,0" />
                                            <TextBlock x:Name="TimerCaption" FontSize="12" Foreground="{DynamicResource Muted}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
                                                    FontWeight="SemiBold" Content="+1" ToolTip="Mais 1 minuto" Click="TimerAdd_Click" />
                                            <Button x:Name="TimerPauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" FontSize="20"
                                                    Width="50" Height="38" Margin="6,0" Click="TimerPause_Click" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Parar" Click="TimerStop_Click" />
                                        </StackPanel>
                                        <Border Grid.Row="1" Height="5" CornerRadius="2.5" Background="{DynamicResource Track}" ClipToBounds="True" Margin="0,0,0,4">
                                            <Border Background="#FFFF9F0A" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="TimerProgressScale" ScaleX="0" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Path x:Name="EarRight" Width="14" Height="14" VerticalAlignment="Top" Fill="Black" Visibility="Collapsed"
                  Data="M14,0 H0 V14 A14,14 0 0 1 14,0 Z" />

            <!-- Microphone / camera in use -->
            <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" VerticalAlignment="Top" IsHitTestVisible="False">
                <Ellipse x:Name="MicDot" Width="7" Height="7" Margin="6,0,0,0" Fill="#FFFF9F0A" Visibility="Collapsed" />
                <Ellipse x:Name="CamDot" Width="7" Height="7" Margin="6,0,0,0" Fill="#FF30D158" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
