<Application x:Class="DynamicIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <!-- recoloured by the light theme (IslandWindow.ApplyLook) -->
        <SolidColorBrush x:Key="Muted" Color="#FF8E8E93" />
        <SolidColorBrush x:Key="Track" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="Ink" Color="White" />
        <SolidColorBrush x:Key="Card" Color="#1CFFFFFF" />
        <SolidColorBrush x:Key="CardHover" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Faint" Color="#66FFFFFF" />
    </Application.Resources>
</Application>
