<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Verificar atualização": opens Android's installer for the APK it downloaded -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- qualifies the connectedDevice foreground service type -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- reconnect to the PC after the phone restarts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- the floating island over other apps (one switch in Android's settings, off until the person turns it on) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- keeps the island alive without a PC link (IslandService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- "Ligações no PC" (off until the person turns it on and grants them): who is calling shows on the PC's island -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- answer and decline from the island (asked the first time a button needs it) -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- the "Hoje" page: next events and the weather where you are (each asked for from its own button) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- to open the Claude app from the island when its notification has nothing to open -->
    <queries>
        <package android:name="com.anthropic.claude" />
        <!-- the logo and name of the app a notification came from (launcher apps only, never the full package list) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DynamicIsland">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.DynamicIsland">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the pairing link from the PC's QR code -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dynamicisland" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- the downloaded update APK, handed to Android's installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>

        <!-- pictures and videos received from the PC (only the app opens it) -->
        <activity
            android:name=".MediaViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.DynamicIsland" />

        <!-- the phone as the PC's touchpad and keyboard (PC tab › Touchpad e teclado) -->
        <activity
            android:name=".TouchpadActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DynamicIsland" />

        <!-- "Compartilhar → Dynamic Island": files, photos, videos or text to the PC (which asks first) -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Mandar pro PC"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- the floating island's "Mandar pro PC" buttons open the picker / read the clipboard through this -->
        <activity
            android:name=".SendPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- asks for a permission the island needs, then closes -->
        <activity
            android:name=".PermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- answers a message notification from the island -->
        <activity
            android:name=".ReplyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- the quick tile reads the clipboard through this (Android only lets an app in front read it) -->
        <activity
            android:name=".ClipActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ClipTileService"
            android:exported="true"
            android:icon="@drawable/ic_send_paste"
            android:label="Copiado → PC"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".IslandService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating island overlay the user turned on, shown over other apps" />
        </service>

        <!-- The notification listener (DiscordListener) and the accessibility service (IslandAccessibility) live in
             src/full/AndroidManifest.xml: Play Protect blocks sideloaded APKs that declare them, with no "install anyway"
             (Brazil's fraud protection), so the APK people download (release) leaves them out. -->

        <receiver
            android:name=".DenyReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
