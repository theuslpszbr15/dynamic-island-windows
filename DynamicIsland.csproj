<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <StartupObject>DynamicIsland.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DynamicIsland.ico</ApplicationIcon>
    <Version>1.9.5</Version>
    <Product>Dynamic Island</Product>
    <Company>theuslpszbr15</Company>
    <!-- WPF needs the manifest for Per-Monitor V2; the WinForms analyzer only applies to WinForms startup. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- A tiny, mostly idle heap: no background GC thread, and compact rather than grow. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- measured: PGO instrumentation cost ~2% of a core for the first minutes and ~5 MB, for code that barely runs -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- the test project lives under tests/ and builds on its own -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\DynamicIsland.ico" LogicalName="DynamicIsland.ico" />
    <!-- "Criar meu repasse" publishes these from the exe (the repository may be private) -->
    <EmbeddedResource Include="relay\package.json;relay\package-lock.json;relay\tsconfig.json;relay\wrangler.toml" LogicalName="relay/%(Filename)%(Extension)" />
    <EmbeddedResource Include="relay\src\index.ts" LogicalName="relay/src/index.ts" />
  </ItemGroup>

  <ItemGroup>
    <!-- GitHub "owner/name" that updates, links and the lyrics User-Agent point to: change it here in a fork. -->
    <AssemblyMetadata Include="UpdateRepository" Value="theuslpszbr15/dynamic-island-windows" />
    <!-- the Android app built alongside: phones with an older one are told to update -->
    <AssemblyMetadata Include="AndroidVersionCode" Condition="Exists('android\app\build.gradle.kts')" Value="$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\android\app\build.gradle.kts')), 'versionCode\s*=\s*(\d+)').Result('$1'))" />
    <AssemblyMetadata Include="AndroidVersionName" Condition="Exists('android\app\build.gradle.kts')" Value="$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\android\app\build.gradle.kts')), 'versionName\s*=\s*&quot;([^&quot;]+)&quot;').Result('$1'))" />
    <InternalsVisibleTo Include="DynamicIsland.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- laptop panel brightness (WmiMonitorBrightness) when the screen has no DDC/CI -->
    <PackageReference Include="NAudio.WinMM" Version="3.3.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- phone link: pairing QR code -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
